---
import '../styles/terminal.css';
import { educationContent, experienceContent, skillsContent } from '../data/commands';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eric Sun's Site</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <script is:inline>
        document.documentElement.dataset.viewMode = 'list';
    </script>
</head>
<body>
    <canvas id="life-canvas" aria-hidden="true"></canvas>

    <section id="neural-background" class="neural-background" aria-label="Interactive handwritten digit neural network">
        <div class="neural-window" aria-hidden="true">
            <div class="neural-window-titlebar">
                <span class="neural-window-mark">[ ]</span>
                <span>mnist.cnn</span>
                <span class="neural-window-rule"></span>
                <span class="neural-window-controls">─ □ ×</span>
            </div>
        </div>
        <div class="mnist-shelf">
            <div class="mnist-samples" aria-label="Handwritten digit samples"></div>
            <button type="button" class="mnist-refresh" id="neural-refresh-samples" aria-label="Generate new digit samples" title="Generate new samples">
                <span aria-hidden="true">↻</span>
            </button>
        </div>

        <div class="network-diagram" id="network-diagram">
            <svg class="neural-links" aria-hidden="true"></svg>

            <div class="network-layer input-layer">
                <div id="neural-input" class="neural-input" aria-label="Digit input drop target" aria-describedby="neural-input-instruction"></div>
                <p class="neural-input-hint" id="neural-input-instruction"><span aria-hidden="true">&lt;== </span>drag input here</p>
            </div>

            <div class="network-layer hidden-layer-one" data-layer="hidden-1">
                <div class="node-row">
                    {Array.from({ length: 8 }, (_, index) => (
                        <span class="neural-node neural-node-small" data-node={`hidden1-${index}`}><i></i></span>
                    ))}
                </div>
            </div>

            <div class="network-layer hidden-layer-two" data-layer="hidden-2">
                <div class="node-row">
                    {Array.from({ length: 8 }, (_, index) => (
                        <span class="neural-node neural-node-small" data-node={`hidden2-${index}`}><i></i></span>
                    ))}
                </div>
            </div>

            <div class="network-hidden-annotation network-annotation">
                <span class="network-vertical-bracket" aria-hidden="true">
                    {['-+', ' |', ' |', ' |', ' |', ' |', '-+'].map((line) => <span>{line}</span>)}
                </span>
                <span class="network-hidden-label">hidden<br />layers</span>
            </div>

            <div class="network-layer output-layer" data-layer="outputs">
                <div class="output-row">
                    {Array.from({ length: 10 }, (_, digit) => (
                        <div class="output-node" data-output={digit}>
                            <span class="neural-node output-light"><i></i></span>
                            <strong>{digit}</strong>
                            <small>0%</small>
                        </div>
                    ))}
                </div>
                <p class="network-output-summary" id="neural-output-summary" aria-live="polite">output: N/A</p>
            </div>

            <div class="node-tooltip" id="neural-node-tooltip" role="tooltip" aria-hidden="true"></div>

            <p class="network-summary">28²→8×6²→8→10 · ReLU · 8ep Adam · tr/eval 92.2/93.0% · edges: cyan + / orange −</p>
            <p class="network-links">
                <span class="link-bracket" aria-hidden="true">[</span>
                <a href="https://en.wikipedia.org/wiki/Convolutional_neural_network" target="_blank" rel="noopener noreferrer">what is this?</a>
                <span aria-hidden="true">·</span>
                <a href="/mnist-model.json" download="mnist-cnn-weights.json">download weights</a>
                <span aria-hidden="true">·</span>
                <a href="https://en.wikipedia.org/wiki/Conway%27s_Game_of_Life" target="_blank" rel="noopener noreferrer">about the background</a>
                <span class="link-bracket" aria-hidden="true">]</span>
            </p>
        </div>
    </section>
    <div class="terminal-container">
        <div id="initial-content">
            <div class="ascii-name">
               <pre class="ascii-art ascii-art-eric" role="img" aria-label="ERIC"><span class="ascii-letter" aria-hidden="true"> ______
/\  ___\
\ \  __\
 \ \_____\
  \/_____/</span><span class="ascii-letter" aria-hidden="true"> ______
/\  == \
\ \  __&lt;
 \ \_\ \_\
  \/_/ /_/</span><span class="ascii-letter" aria-hidden="true"> __
/\ \
\ \ \
 \ \_\
  \/_/</span><span class="ascii-letter" aria-hidden="true"> ______
/\  ___\
\ \ \____
 \ \_____\
  \/_____/</span></pre>
               <pre class="ascii-art ascii-art-sun" role="img" aria-label="SUN"><span class="ascii-letter" aria-hidden="true">  ______
 /\  ___\
 \ \___  \
  \/\_____\
   \/_____/</span><span class="ascii-letter" aria-hidden="true"> __  __
/\ \/\ \
\ \ \_\ \
 \ \_____\
  \/_____/</span><span class="ascii-letter" aria-hidden="true"> __   __
/\ "-.\ \
\ \ \-.  \
 \ \_\\"\_\
  \/_/ \/_/</span></pre>
            </div>
                <div class="output-line intro-actions">
                    <span class="contact-links"><span class="link-bracket" aria-hidden="true">[</span> <a href="https://github.com/therealericsun" target="_blank">GitHub</a> · <a href="https://www.linkedin.com/in/eric-sun-a323461a0/" target="_blank">LinkedIn</a> · <a href="mailto:ericsun@seas.upenn.edu">Email</a> · <a href="/Eric_Sun_Resume.pdf" download>Resume</a> <span class="link-bracket" aria-hidden="true">]</span></span>
                    <span class="view-mode-toggle" role="group" aria-label="Choose site view">
                        <span class="view-mode-label">view:</span>
                        <button type="button" data-view-mode="terminal" aria-controls="terminal-view" aria-pressed="false">terminal</button>
                        <span aria-hidden="true">·</span>
                        <button type="button" data-view-mode="list" aria-controls="list-view" aria-pressed="false">list</button>
                    </span>
                </div>
                <div class="intro-spacer"></div>
                <div class="output-line intro-text">My name is Eric Sun (he/him). I study Physics and Computer Science at the University of Pennsylvania. My primary interests are in machine learning, numeric simulations, and high-performance computing.</div>
                <div class="intro-spacer terminal-view-only"></div>
                <div class="output-line terminal-view-only">Type <span class="command">help</span> to see available commands.</div>
                <div class="output-line tab-hint terminal-view-only">Tip: Use TAB for autocomplete and UP/DOWN to scroll terminal history</div>
                <div class="output-line separator-line terminal-view-only">─────────────────────────────────────────────────────────</div>
                <section id="list-view" class="list-view list-view-only" aria-label="Experience, education, and skills">
                    <h2 class="list-heading">Experience</h2>
                    <div set:html={experienceContent}></div>
                    <h2 class="list-heading">Education</h2>
                    <div set:html={educationContent}></div>
                    <h2 class="list-heading">Skills</h2>
                    <div set:html={skillsContent}></div>
                </section>
        </div>
        <div id="terminal-view" class="terminal-scroll terminal-view-only" role="region" aria-label="Terminal history">
            <div id="output"></div>
            <div class="input-line">
            <span class="prompt">visitor@portfolio:~$</span>
            <input 
                type="text" 
                id="command-input" 
                aria-label="Terminal command"
                autocomplete="off" 
                spellcheck="false" 
            />
            </div>
        </div>
    </div>

    <div class="copyright">
        © <span id="current-year"></span> Eric Sun
    </div>

    <script>
        import '../scripts/terminal.ts';
        import '../scripts/life.ts';
        import '../scripts/neural.ts';
    </script>
</body>
</html>
